#
# Extremely simple MTA that accepts local mail by simulating a sendmail binary
# and forwards it to a real mail server. Heavily inspired by ssmtp.
#
# Copy/symlink it to:
# - /usr/sbin/sendmail
# - /usr/lib/sendmail
# - /usr/bin/mailq
# - /usr/bin/newaliases
#
# Run `tinymta -q` in a cron job or similar to try sending queued mails again.
#
# Example config file (/etc/tinymta.toml):
#
# recipient = "foo@example.com"
# smarthost = "mail.example.com"
# username = "foo"
# password = "password"

from __future__ import annotations

import argparse
import email
import email.utils
import getpass
import socket
import sys
import syslog
import traceback
import uuid
from dataclasses import dataclass
from email.utils import make_msgid
from pathlib import Path
from smtplib import SMTP_SSL, SMTPException
from typing import TYPE_CHECKING, Any

import tomllib

if TYPE_CHECKING:
    from collections.abc import Sequence
    from email.message import Message

SPOOL = Path("/var/spool/tinymta")


@dataclass
class Config:
    recipient: str
    smarthost: str
    username: str
    password: str


unsupported_args = ["ba", "bd", "bs", "bt", "bv", "bz"]
ignored_args = [
    ("B", 1),
    ("bi", 0),
    ("bm", 0),
    ("E", 0),
    ("h", 1),
    ("i", 0),
    ("m", 0),
    ("M", 1),
    ("n", 0),
    ("N", 1),
    ("o", 1),
    ("R", 1),
    ("t", 0),
]


# Unsupported arguments raise an error
class UnsupportedAction(argparse.Action):
    def __call__(
        self,
        _parser: argparse.ArgumentParser,
        _namespace: argparse.Namespace,
        _values: str | Sequence[Any] | None,
        option_string: str | None = None,
    ) -> None:
        print(f"{option_string} option not supported")
        sys.exit(1)


class IgnoredAction(argparse.Action):
    def __call__(
        self,
        parser: argparse.ArgumentParser,
        namespace: argparse.Namespace,
        values: str | Sequence[Any] | None,
        option_string: str | None = None,
    ) -> None:
        pass


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="tinymta", add_help=False)
    parser.add_argument("rcpts", nargs="*")
    parser.add_argument("-F", dest="fullname")
    parser.add_argument("-f", "-r", dest="fromaddr")
    parser.add_argument("-d", "--debug", action="store_true", default=False)
    parser.add_argument("-bp", action="store_true", default=False)
    parser.add_argument("-q", nargs="?", default=argparse.SUPPRESS)

    for arg in unsupported_args:
        parser.add_argument("-" + arg, action=UnsupportedAction, nargs=0)
    for [arg, nargs] in ignored_args:
        parser.add_argument("-" + arg, action=IgnoredAction, nargs=nargs)

    return parser.parse_args()


def send_message(
    msg: Message,
    rcpts: list[str],
    fromaddr: str | None,
    config: Config,
    debug: bool,
) -> None:
    syslog.openlog(ident="tinymta", facility=syslog.LOG_MAIL)

    username = getpass.getuser()

    # Construct a "From" header from explicit argument, existing header,
    # or username
    if fromaddr is None:
        fromaddr = msg.get("From") or username
    if "@" not in fromaddr:
        if Path("/etc/mailname").exists():
            fromaddr += "@" + Path("/etc/mailname").read_text().strip()
        else:
            fromaddr += "@" + socket.getfqdn()
    if "From" in msg:
        msg.replace_header("From", fromaddr)
    else:
        msg.add_header("From", fromaddr)

    if msg.get("To") is None:
        msg.add_header("To", ", ".join(rcpts))

    if msg.get("Date") is None:
        msg.add_header("Date", email.utils.formatdate(localtime=True))

    if "Message-ID" in msg:
        msg.replace_header("Message-ID", make_msgid())
    else:
        msg.add_header("Message-ID", make_msgid())

    try:
        do_send(msg, config, debug)
    except SMTPException as e:
        syslog.syslog(syslog.LOG_WARNING, f"Error sending mail, queuing: {e}")
        SPOOL.mkdir(0o770, parents=True, exist_ok=True)
        msg_file = SPOOL / (uuid.uuid4().hex + ".msg")
        tmp_file = msg_file.parent / (msg_file.name + ".tmp")
        tmp_file.write_text(msg.as_string())
        tmp_file.rename(msg_file)


def list_queue() -> None:
    for file in SPOOL.glob("*.msg"):
        with file.open() as f:
            msg = email.message_from_file(f)
        print(
            f"""{file.name}:
    Subject: {msg.get("Subject")}
    From: {msg.get("From")}
    To: {msg.get("To")}
""".strip()
        )


def process_queue(config: Config, debug: bool) -> None:
    lockfile = SPOOL / "queue.lock"
    try:
        lockfile.touch(mode=0o660, exist_ok=False)
    except FileExistsError:
        syslog.syslog(syslog.LOG_WARNING, "Queue process already running; exiting")
        return

    try:
        for file in SPOOL.glob("*.msg"):
            with file.open() as f:
                msg = email.message_from_file(f)
            try:
                do_send(msg, config, debug)
                file.unlink()
            except SMTPException as e:
                syslog.syslog(
                    syslog.LOG_WARNING, f"Error sending mail, leaving in queue: {e}"
                )
                return
    finally:
        lockfile.unlink()


def do_send(msg: Message, config: Config, debug: bool) -> None:
    with SMTP_SSL(config.smarthost) as smtp:
        if debug:
            smtp.set_debuglevel(1)
        smtp.login(config.username, config.password)

        # Use the recipient as the envelope FROM in case the sender domain is
        # considered invalid by the smarthost (like GMail)
        smtp.send_message(msg, from_addr=config.recipient, to_addrs=config.recipient)

        syslog.syslog(
            syslog.LOG_INFO,
            f"Sent mail with subject '{msg.get('Subject')}' to {msg.get('To')}",
        )


def main(args: argparse.Namespace) -> None:
    with Path("/etc/tinymta.toml").open("rb") as f:
        config = Config(**tomllib.load(f))

    name = Path(sys.argv[0]).name

    if name == "mailq" or args.bp:
        list_queue()
    elif "q" in args:
        process_queue(config, args.debug)
    elif name == "newaliases":
        print(f"{name}: Aliases are not used in tinymta")
    else:
        msg = email.message_from_file(sys.stdin)
        try:
            send_message(msg, args.rcpts, args.fromaddr, config, args.debug)
        except Exception:
            syslog.syslog(syslog.LOG_ERR, traceback.format_exc())

            path = Path.home() / "dead.letter"
            syslog.syslog(syslog.LOG_INFO, f"Writing mail to {path}")
            with path.open("a") as f:
                f.write("\n" if path.exists() else "")
                f.write(msg.as_string())

            raise


if __name__ == "__main__":
    main(parse_args())
